# Type signatures for Bio::Sequence::NA

module Bio
  class Sequence
    class NA < String
      include Common

      def initialize: (String str) -> void
      def forward_complement: () -> String
      def forward_complement!: () -> String
      def reverse_complement: () -> String
      def reverse_complement!: () -> String
      alias complement reverse_complement
      alias complement! reverse_complement!
      def translate: (?Integer frame, ?untyped table, ?String unknown) -> Bio::Sequence::AA
      def codon_usage: () -> Hash[String, Integer]
      def gc_percent: () -> Integer
      def gc_content: () -> (Float | Rational)
      def at_content: () -> (Float | Rational)
      def gc_skew: () -> (Float | Rational)
      def at_skew: () -> (Float | Rational)
      def illegal_bases: () -> Array[String]
      def molecular_weight: () -> Float
      def to_re: () -> Regexp
      def names: () -> Array[String]
      def dna: () -> String
      def dna!: () -> String
      def rna: () -> String
      def rna!: () -> String
      def cut_with_enzyme: (*untyped args) -> untyped
      alias cut_with_enzymes cut_with_enzyme

      private

      def rna?: () -> Integer?
    end
  end
end
